// Two profiles that drive the two demo runs. They differ in tool versions /
// images (software layer), aligner (params + software), ALIGN resources (config
// + resource-efficiency), ALIGN runtime (performance regressions), whether a
// MARKDUP stage runs (topology + DAG wiring) and whether one sample's QC gate
// fails (failure rollup + log diff + exit-code flip).
//
// Containers are attached per process so the run cache records a real image per
// task — that is what drives nf-diff's software & versions layer. Every image
// referenced here is already present locally (see `docker images`), so nothing
// is pulled. The commands themselves are trivial shell (echo/grep/cat/sleep).

docker.enabled = true

// Authoritative process wiring for `--diff-dag` (Nextflow 25.04+).
lineage.enabled = true

params {
    genome       = 'GRCh38'
    aligner      = 'bwa'
    aligner_tag  = '0.7.17'
    samtools_tag = '1.15'
    fastqc_tag   = '0.11.9'
    multiqc_tag  = '1.13'
    align_cpus   = 2
    align_mem    = '4 GB'
    align_sleep  = 1
    markdup      = false
    fail_sample  = ''
}

profiles {

    // Run A — the baseline.
    baseline {
        params {
            aligner      = 'bwa'
            aligner_tag  = '0.7.17'
            samtools_tag = '1.15'
            fastqc_tag   = '0.11.9'
            multiqc_tag  = '1.13'
            align_cpus   = 2
            align_mem    = '4 GB'
            align_sleep  = 1
            markdup      = false
            fail_sample  = ''
        }
        process {
            withName: INDEX_REF { container = 'community.wave.seqera.io/library/htslib_samtools:1.24--d697cfb9dce007cd' }
            withName: ALIGN     { container = 'community.wave.seqera.io/library/bowtie2_htslib_samtools_pigz:edeb13799090a2a6' }
            withName: QC        { container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0' }
            withName: MULTIQC   { container = 'community.wave.seqera.io/library/seqkit:2.13.0--05c0a96bf9fb2751' }
        }
    }

    // Run B — a switched aligner and QC tool (software changes), an added
    // MARKDUP stage (topology + DAG + software added), a heavier and slower
    // ALIGN, and a failing QC gate on one sample.
    changed {
        params {
            aligner      = 'bwa-mem2'
            aligner_tag  = '2.2.1'
            samtools_tag = '1.19'
            fastqc_tag   = '0.12.1'
            multiqc_tag  = '1.21'
            align_cpus   = 4
            align_mem    = '8 GB'
            align_sleep  = 6
            markdup      = true
            fail_sample  = 'sampleB'
        }
        process {
            withName: INDEX_REF { container = 'community.wave.seqera.io/library/htslib_samtools:1.24--d697cfb9dce007cd' }
            withName: ALIGN     { container = 'community.wave.seqera.io/library/bbmap_pigz:07416fe99b090fa9' }
            withName: MARKDUP   { container = 'quay.io/biocontainers/prinseq-plus-plus:1.2.3--hc90279e_1' }
            withName: QC        { container = 'community.wave.seqera.io/library/fastp:1.3.6--4df8d6c11b471bde' }
            withName: MULTIQC   { container = 'community.wave.seqera.io/library/seqkit:2.13.0--05c0a96bf9fb2751' }
        }
    }
}
